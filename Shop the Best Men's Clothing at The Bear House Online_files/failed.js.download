

async function MakeErrorLog () {
    var data = {
        status_code: '500',
        status: 'error'
    }
    var log_url = 'https://static-cdn.yutoads.com/register-error/';

    try {
            let response = await fetch(
                log_url, {
                    method: 'POST',
                    body: new URLSearchParams(data),
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8'
                    },
                })
    } catch (error) {
    }
    return ''
}
MakeErrorLog()
